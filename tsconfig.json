{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./shared/*"]
    }
  },
  "include": ["src/**/*.ts", "shared/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest.config.mts"]
}
